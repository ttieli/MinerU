# MinerU M芯片完整版 Dockerfile
# 基于Python 3.11镜像，为Apple Silicon优化，包含所有修复
FROM python:3.11-slim

# 维护者信息
LABEL maintainer="MinerU Team <support@mineru.net>"
LABEL description="MinerU Full-Featured Docker Image for Apple Silicon"
LABEL version="2.0-full"

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    DEVICE_MODE=mps \
    ENABLE_VLM=true \
    ENABLE_PIPELINE=true \
    ENABLE_TABLE=true \
    ENABLE_FORMULA=true \
    MAX_WORKERS=4 \
    BATCH_SIZE=2 \
    MEMORY_LIMIT=8G \
    MODEL_PRECISION=fp16 \
    PYTORCH_ENABLE_MPS_FALLBACK=1 \
    PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0 \
    MPS_MEMORY_FRACTION=0.8 \
    PYTHONPATH=/app

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        wget \
        git \
        unzip \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        libopencv-dev \
        python3-opencv \
        fonts-dejavu-core \
        fontconfig \
        ca-certificates \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/* \
        && fc-cache -fv

# 创建必要目录
RUN mkdir -p /app/logs \
             /app/output \
             /app/temp \
             /app/cache

# 先复制整个项目
COPY . /app

# 复制requirements文件
COPY docker/m1-mac-full/requirements-full.txt requirements.txt

# 安装Python依赖
RUN pip install --no-cache-dir -U pip setuptools wheel

# 基础科学计算库
RUN pip install --no-cache-dir \
    numpy>=1.24.4 \
    scipy>=1.11.0 \
    pillow>=11.0.0 \
    opencv-python-headless>=4.8.1.78

# PyTorch生态（MPS支持）
RUN pip install --no-cache-dir \
    torch>=2.2.2 \
    torchvision>=0.17.0 \
    torchaudio>=2.2.0 \
    --index-url https://download.pytorch.org/whl/cpu

# 机器学习框架
RUN pip install --no-cache-dir \
    transformers>=4.49.0 \
    accelerate>=1.5.1 \
    huggingface-hub>=0.32.4

# 安装其他依赖
RUN pip install --no-cache-dir -r requirements.txt

# 应用所有修复
# 1. 修复 model_json_to_middle_json 函数
RUN echo "" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "# 完整版兼容性修复" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "from .result_to_middle_json import result_to_middle_json" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "model_json_to_middle_json = result_to_middle_json" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py

# 2. 修复 mk_content 函数
RUN echo "" >> /app/mineru/backend/pipeline/pipeline_middle_json_mkcontent.py && \
    echo "# 完整版兼容性修复" >> /app/mineru/backend/pipeline/pipeline_middle_json_mkcontent.py && \
    echo "from .union_make import union_make" >> /app/mineru/backend/pipeline/pipeline_middle_json_mkcontent.py && \
    echo "mk_content = union_make" >> /app/mineru/backend/pipeline/pipeline_middle_json_mkcontent.py

# 3. 修复 get_lang_by_content 函数
RUN echo "" >> /app/mineru/utils/language.py && \
    echo "# 完整版兼容性修复" >> /app/mineru/utils/language.py && \
    echo "def get_lang_by_content(content):" >> /app/mineru/utils/language.py && \
    echo "    \"\"\"检测内容语言\"\"\"" >> /app/mineru/utils/language.py && \
    echo "    if isinstance(content, bytes):" >> /app/mineru/utils/language.py && \
    echo "        content = content.decode('utf-8', errors='ignore')" >> /app/mineru/utils/language.py && \
    echo "    # 简单的语言检测逻辑" >> /app/mineru/utils/language.py && \
    echo "    if any(ord(char) > 127 for char in content[:100]):" >> /app/mineru/utils/language.py && \
    echo "        return 'zh'" >> /app/mineru/utils/language.py && \
    echo "    return 'en'" >> /app/mineru/utils/language.py

# 复制完整版应用文件
COPY docker/m1-mac-full/app_full.py app.py

# 创建启动脚本
RUN echo '#!/bin/bash' > entrypoint.sh && \
    echo 'exec python app.py "$@"' >> entrypoint.sh && \
    chmod +x entrypoint.sh

# 创建健康检查脚本
RUN echo '#!/bin/bash' > healthcheck.sh && \
    echo 'curl -f http://localhost:8000/health || exit 1' >> healthcheck.sh && \
    chmod +x healthcheck.sh

# 创建非root用户
RUN groupadd -r mineru && \
    useradd -r -g mineru -d /app -s /bin/bash mineru && \
    chown -R mineru:mineru /app

# 暴露端口
EXPOSE 8000

# 设置数据卷
VOLUME ["/app/output", "/app/logs", "/app/cache"]

# 健康检查
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD ./healthcheck.sh

# 切换到非root用户
USER mineru

# 启动命令
ENTRYPOINT ["./entrypoint.sh"]
CMD ["--host", "0.0.0.0", "--port", "8000"]