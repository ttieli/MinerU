# MinerU M芯片最小化版 Dockerfile
# 基于Python 3.10镜像，减少网络依赖
FROM python:3.10-slim

# 维护者信息
LABEL maintainer="MinerU Team"
LABEL description="MinerU M芯片全功能版 - 最小化版本"

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# 只安装最基础的依赖，跳过可能有问题的包
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        wget \
        git \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

# 复制requirements文件
COPY requirements-full.txt /tmp/requirements-full.txt

# 升级pip并安装Python依赖
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /tmp/requirements-full.txt

# 复制应用代码
COPY . /app/

# 复制配置文件
COPY magic-pdf-full.json /app/magic-pdf-full.json
COPY entrypoint.sh /app/entrypoint.sh
COPY healthcheck.sh /app/healthcheck.sh

# 设置执行权限
RUN chmod +x /app/entrypoint.sh /app/healthcheck.sh

# 创建必要的目录
RUN mkdir -p /app/logs /app/temp /app/output

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh

# 暴露端口
EXPOSE 8000

# 启动命令
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "app_full.py"] 