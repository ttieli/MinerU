# MinerU 完整版 - 基于简化版的高效构建（最终修复版）
FROM m1-mac-mineru-m1:latest

# 维护者信息
LABEL maintainer="MinerU Team <support@mineru.net>"
LABEL description="MinerU Full-Featured Docker Image for Apple Silicon - Fixed"
LABEL version="2.0-full-fixed"

# 设置完整版环境变量
ENV ENABLE_VLM=true \
    ENABLE_PIPELINE=true \
    ENABLE_TABLE=true \
    ENABLE_FORMULA=true \
    MAX_WORKERS=4 \
    BATCH_SIZE=2 \
    MODEL_PRECISION=fp16 \
    MEMORY_EFFICIENT_MODE=true

# 安装完整版额外依赖
RUN pip install --no-cache-dir \
    # 表格识别增强
    rapid_table>=1.0.5 \
    # OCR增强
    easyocr>=1.7.0 \
    pytesseract>=0.3.10 \
    # 科学计算增强
    scikit-image>=0.22.0 \
    # 文档处理增强
    python-docx>=1.1.0 \
    openpyxl>=3.1.0 \
    # 高级视觉检测
    ultralytics>=8.3.48 \
    doclayout_yolo==0.0.4

# 复制整个项目（获取最新修复）
COPY . /app

# 应用必要的兼容性修复
# 1. 修复 model_json_to_middle_json 函数
RUN echo "" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "# 完整版兼容性修复" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "try:" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "    from .result_to_middle_json import result_to_middle_json" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "    model_json_to_middle_json = result_to_middle_json" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "except ImportError:" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "    def model_json_to_middle_json(*args, **kwargs):" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py && \
    echo "        raise NotImplementedError('model_json_to_middle_json not available')" >> /app/mineru/backend/pipeline/model_json_to_middle_json.py

# 2. 修复 get_lang_by_content 函数 (添加file_name参数支持)
RUN echo "" >> /app/mineru/utils/language.py && \
    echo "# 完整版兼容性修复" >> /app/mineru/utils/language.py && \
    echo "def get_lang_by_content(content, file_name=None):" >> /app/mineru/utils/language.py && \
    echo "    \"\"\"检测内容语言\"\"\"" >> /app/mineru/utils/language.py && \
    echo "    if isinstance(content, bytes):" >> /app/mineru/utils/language.py && \
    echo "        content = content.decode('utf-8', errors='ignore')" >> /app/mineru/utils/language.py && \
    echo "    # 简单的语言检测逻辑" >> /app/mineru/utils/language.py && \
    echo "    if any(ord(char) > 127 for char in content[:100]):" >> /app/mineru/utils/language.py && \
    echo "        return 'zh'" >> /app/mineru/utils/language.py && \
    echo "    return 'en'" >> /app/mineru/utils/language.py

# 注意：不修复 mk_content 函数，因为原本的函数是正确的
# mk_content 函数已经在源码中正确定义，无需额外修复

# 复制完整版应用文件
COPY docker/m1-mac-full/app_full.py app.py

# 启动命令
ENTRYPOINT ["./entrypoint.sh"]
CMD ["--host", "0.0.0.0", "--port", "8000"]