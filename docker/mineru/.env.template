# MinerU Docker 环境变量配置模板
# 复制此文件为 .env 并根据需要修改配置

# ========== 基本配置 ==========
# 构建日期（自动生成）
BUILD_DATE=

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ========== 设备配置 ==========
# 设备模式 (cpu, mps, cuda)
DEVICE_MODE=cpu

# MPS内存限制（仅M1/M2 Mac）
MPS_MEMORY_LIMIT=8G

# CPU线程数配置
TORCH_NUM_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# ========== 模型路径配置 ==========
# Simple版本模型路径
SIMPLE_MODELS_PATH=./models/simple

# Full版本模型路径
FULL_MODELS_PATH=./models/full

# ========== 端口配置 ==========
# Simple版本API端口
SIMPLE_API_PORT=8000

# Full版本API端口
FULL_API_PORT=8001

# Redis端口
REDIS_PORT=6379

# Nginx HTTP端口
HTTP_PORT=80

# Nginx HTTPS端口
HTTPS_PORT=443

# ========== 性能配置 ==========
# Simple版本配置
SIMPLE_MAX_WORKERS=6
SIMPLE_MEMORY_LIMIT=4G
SIMPLE_CPU_LIMIT=2.0

# Full版本配置
FULL_MAX_WORKERS=4
FULL_MEMORY_LIMIT=16G
FULL_CPU_LIMIT=8.0

# ========== 功能开关 ==========
# 是否启用VLM（仅Full版本）
ENABLE_VLM=true

# 是否启用表格识别
ENABLE_TABLE=true

# 是否启用公式识别（仅Full版本）
ENABLE_FORMULA=true

# ========== 内存优化 ==========
# 内存高效模式（仅Full版本）
MEMORY_EFFICIENT_MODE=true

# 模型CPU卸载（仅Full版本）
MODEL_OFFLOAD_CPU=true

# 缓存清理间隔
CLEAR_CACHE_INTERVAL=100

# ========== 安全配置 ==========
# SSL证书路径（生产环境）
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# Grafana管理员密码（监控服务）
GRAFANA_PASSWORD=admin123

# ========== 开发配置 ==========
# 是否启用开发模式
DEV_MODE=false

# 是否启用调试日志
DEBUG_MODE=false

# 是否跳过模型下载
SKIP_MODEL_DOWNLOAD=false